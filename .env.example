# Настройки продакшена. Скопируйте в .env и заполните: cp .env.example .env
# Файл .env содержит секреты – не коммитьте его (он в .gitignore).

# Адрес сайта для Caddy:
#   tests.example.ru – публичный домен, HTTPS-сертификат Let's Encrypt получается автоматически
#   :80              – только HTTP, если HTTPS обеспечивает прокси вуза перед сервером
SITE_ADDRESS=tests.example.ru

# Ключ подписи сессий, от 32 символов. Сгенерировать:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Пароль базы данных (любой длинный случайный, вводить руками его не придётся).
POSTGRES_PASSWORD=

# --- необязательное --------------------------------------------------------------

# Образ приложения. По умолчанию – опубликованный в GitHub Container Registry;
# закомментируйте и используйте `docker compose ... up -d --build`, чтобы собрать на сервере.
# APP_IMAGE=ghcr.io/viteax/competency-assessment:2.0.0

# Процессов приложения (по 1–2 на ядро процессора).
# WEB_CONCURRENCY=2

# Часовой пояс сервера (TZ): время бэкапов и «сегодня» в приложении (текущий семестр групп).
# Бэкапы: время ежедневной копии (по TZ), сколько дней хранить, куда складывать.
# BACKUP_TIME=03:30
# BACKUP_KEEP_DAYS=30
# BACKUP_DIR=./backups
# TZ=Asia/Tomsk

# Копии вне сервера (настройка – deploy/setup-offsite.sh): сколько дней хранить в хранилище.
# OFFSITE_KEEP_DAYS=90

# Мониторинг копий: адрес проверки на healthchecks.io. Сервис offsite раз в час сообщает туда,
# что свежая копия есть и отправлена; если сообщения прекратятся, придет письмо.
# С российских IP healthchecks.io не работает (отвечает 403) – тогда нужен VK, ниже.
# HEALTHCHECK_URL=https://hc-ping.com/...

# Мониторинг копий во VK: сообщество пишет вам в личку о сбое сразу, «все в порядке» – раз в
# день. Токен сообщества с правом «Сообщения сообщества», id – ваш числовой id во VK; один раз
# напишите сообществу сами, иначе VK не даст ему ответить.
# NOTIFY_VK_TOKEN=vk1.a....
# NOTIFY_VK_USER_ID=123456

# Порог «компетенция сформирована» – доля верных ответов. Значение по умолчанию, пока
# администратор не задал свой в интерфейсе («Справочники → Настройки»).
# MASTERY_THRESHOLD=0.6

# Сессия завершается после стольких минут без действий.
# SESSION_IDLE_MINUTES=60

# Подробность логов: DEBUG, INFO, WARNING.
# LOG_LEVEL=INFO
